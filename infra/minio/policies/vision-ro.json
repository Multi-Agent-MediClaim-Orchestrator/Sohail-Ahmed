{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Effect": "Allow",
   "Action": [
    "s3:GetObject"
   ],
   "Resource": [
    "arn:aws:s3:::hospital-docs/*/*/pages/*",
    "arn:aws:s3:::insurer-docs/*/*/pages/*"
   ]
  },
  {
   "Effect": "Allow",
   "Action": [
    "s3:GetBucketLocation"
   ],
   "Resource": [
    "arn:aws:s3:::hospital-docs",
    "arn:aws:s3:::insurer-docs"
   ]
  }
 ]
}