# copy to .env (gitignored)
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum-0000000
INS_N8N_WEBHOOK_SECRET=dev-n8n-webhook-secret
INS_API_URL=http://insurer-api:8100
INS_CREW_URL=http://insurer-crew:8110
INS_CREW_SERVICE_TOKEN=dev
INS_KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/claims/protocol/openid-connect/token
EXECUTIONS_MODE=queue
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
