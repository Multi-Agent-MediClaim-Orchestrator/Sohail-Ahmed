{
  "id": "11_step_document_fetch",
  "name": "11_step_document_fetch",
  "nodes": [
    {
      "parameters": {
        "content": "Step document_fetch: start -> (context -> crew, if agent-backed) -> post the result; the API computes the deterministic part. Failure policy 6.15: crew unavailable or invalid output -> post a failure body, the run continues.",
        "height": 120,
        "width": 420
      },
      "name": "Sticky purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -220
      ]
    },
    {
      "parameters": {},
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INS_API_URL }}/internal/runs/{{ $('Execute Workflow Trigger').first().json.run_id }}/steps/document_fetch/start",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        },
        "sendHeaders": true,
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $crypto.createHash('sha1').update($execution.id + ':POST step start').digest('hex') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}"
      },
      "name": "POST step start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "insurer-keycloak-client",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.INS_API_URL }}/internal/cases/{{ $('Execute Workflow Trigger').first().json.case_id }}/docs-status",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        },
        "sendHeaders": true,
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "name": "GET docs-status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "insurer-keycloak-client",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.terminal }}",
              "value2": true
            }
          ]
        }
      },
      "name": "IF fetching finished",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "name": "Wait 3s and poll again",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INS_API_URL }}/internal/runs/{{ $('Execute Workflow Trigger').first().json.run_id }}/steps/document_fetch/evaluate",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        },
        "sendHeaders": true,
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
