{
  "id": "00_common_error_handler",
  "name": "00_common_error_handler",
  "nodes": [
    {
      "parameters": {
        "content": "Error Trigger -> strip context/body -> raise alert -> mark run failed (if known).",
        "height": 120,
        "width": 420
      },
      "name": "Sticky purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -220
      ]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json; delete j.context; delete j.body; delete j.payload; return [{ json: j }];"
      },
      "name": "Strip payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INS_API_URL }}/internal/alerts",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        },
        "sendHeaders": true,
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $crypto.createHash('sha1').update($execution.id + ':POST alert').digest('hex') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({severity:\"high\", source:\"n8n\", workflow:$json.workflow?.name, node:$json.execution?.lastNodeExecuted, message:$json.execution?.error?.message, execution_id:$json.execution?.id}) }}"
      },
      "name": "POST alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "insurer-keycloak-client",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Strip payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Strip payload": {
      "main": [
        [
          {
            "node": "POST alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "tags": [
    {
      "id": "insurerTag00001",
      "name": "insurer"
    }
  ]
}
