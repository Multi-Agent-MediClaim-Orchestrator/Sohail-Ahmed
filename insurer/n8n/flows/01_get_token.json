{
  "id": "01_get_token",
  "name": "01_get_token",
  "nodes": [
    {
      "parameters": {
        "content": "Keycloak client-credentials token, cached in workflow static data for 4 minutes.",
        "height": 120,
        "width": 420
      },
      "name": "Sticky purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -220
      ]
    },
    {
      "parameters": {},
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "functionCode": "const sd = $getWorkflowStaticData('global'); const ok = sd.token && sd.exp > Date.now(); return [{json:{ok, token: sd.token}}];"
      },
      "name": "Check cache",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "name": "IF cached",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INS_KEYCLOAK_TOKEN_URL }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "client_credentials"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "options": {}
      },
      "name": "POST token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        200
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    },
    {
      "parameters": {
        "functionCode": "const sd = $getWorkflowStaticData('global'); sd.token = $json.access_token; sd.exp = Date.now() + ($json.expires_in - 60) * 1000; return [{json:{token: sd.token}}];"
      },
      "name": "Store token",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Check cache",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check cache": {
      "main": [
        [
          {
            "node": "IF cached",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF cached": {
      "main": [
        [],
        [
          {
            "node": "POST token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST token": {
      "main": [
        [
          {
            "node": "Store token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "errorWorkflow": "00_common_error_handler"
  },
  "tags": [
    {
      "id": "insurerTag00001",
      "name": "insurer"
    }
  ]
}
