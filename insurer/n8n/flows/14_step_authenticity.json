        "oAuth2Api": {
          "id": "insurer-keycloak-client",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.INS_API_URL }}/internal/cases/{{ $('Execute Workflow Trigger').first().json.case_id }}/context?for=authenticity",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        },
        "sendHeaders": true,
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "name": "GET context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "insurer-keycloak-client",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{json:{path:'/v1/authenticity/analyze', body: {request_id: require('crypto').randomUUID(), case_id: $('Execute Workflow Trigger').first().json.case_id, context: $json, options: {}}}}];"
      },
      "name": "Build crew request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": "03_call_crew",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "name": "Call crew",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const o = $input.first().json;\nlet payload;\nif (o.ok) {\n  const out = o.output || {};\n  const notes = out.reconciliation_notes || (out.explanations || []).join('; ') || out.waiting_notes || null;\n  const ao = Object.assign({}, out); delete ao.token_usage;\n  payload = {step: 'authenticity', agent: {name: 'authenticity_agent', prompt_version: out.prompt_version || '', trace_id: out.trace_id || null}, agent_notes: notes, degraded: !!out.degraded, agent_output: ao};\n} else {\n  payload = {step: 'authenticity', failure: o.reason === 'invalid_output' ? 'agent_invalid_output' : 'agent_unavailable', degraded: true};\n}\nreturn [{json: {payload}}];"
      },
      "name": "Build step result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
