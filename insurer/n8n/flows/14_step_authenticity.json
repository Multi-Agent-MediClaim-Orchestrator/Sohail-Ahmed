        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $crypto.createHash('sha1').update($execution.id + ':POST step result').digest('hex') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "name": "POST step result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1680,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "insurer-keycloak-client",
          "name": "insurer-keycloak-client"
        }
      },
      "continueOnFail": false
    }
